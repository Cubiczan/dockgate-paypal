# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty for MOCK mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox business account email of the supplier (payee)
PAYEE_EMAIL=
# Optional OpenAI-compatible LLM for the receiving clerk (falls back to a heuristic parser)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
